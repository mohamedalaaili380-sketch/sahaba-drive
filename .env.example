# كل المتغيرات اختيارية — التطبيق بيشتغل بالقيم دي افتراضياً
# انسخ الملف باسم .env.local لو تحب تغيّر حاجة (مش مطلوب للاستخدام المحلي)

# منفذ الـ API / الإنتاج
PORT=4000
HOST=0.0.0.0

# مكان قاعدة البيانات والملفات (افتراضي: ./data داخل المشروع)
SAHABA_DATA_DIR=./data

# أقصى حجم ملف مرفوع بالميجابايت (الافتراضي في الوضع المحلي)
SAHABA_MAX_UPLOAD_MB=4096

# عدد الإصدارات المحتفظة بكل ملف
SAHABA_MAX_VERSIONS=50

# مساحة كل مستخدم بالميجابايت
SAHABA_STORAGE_LIMIT_MB=10240

# تخزين الملفات على Google Drive عبر Apps Script Web App
# لو SAHABA_DRIVE_WEBAPP_URL متضبط، الوضع drive هيشتغل تلقائياً.
SAHABA_STORAGE_MODE=drive
SAHABA_DRIVE_WEBAPP_URL=
SAHABA_DRIVE_TOKEN=
# قيمة أصغر مناسبة لحد URL Fetch في Apps Script (الوضع drive)
SAHABA_MAX_UPLOAD_MB=20

# لمرة واحدة فقط عند النقل من حساب Drive قديم إلى حساب جديد
SAHABA_DRIVE_MIGRATE_FROM_URL=
SAHABA_DRIVE_MIGRATE_FROM_TOKEN=
