# All variables are optional — the app works with these defaults.
# Copy this file to .env.local if you want to change something (not required for local use).

# API / production port
PORT=4000
HOST=0.0.0.0

# Main admin email (promoted at startup)
SAHABA_ADMIN_EMAIL=

# Database and file location (default: ./data inside the project)
SAHABA_DATA_DIR=./data

# Maximum upload size in MB (local-mode default)
SAHABA_MAX_UPLOAD_MB=4096

# Versions retained per file
SAHABA_MAX_VERSIONS=50

# Storage quota per user in MB
SAHABA_STORAGE_LIMIT_MB=10240

# File storage on Google Drive via Apps Script Web App
# If SAHABA_DRIVE_WEBAPP_URL is set, drive mode is enabled automatically.
SAHABA_STORAGE_MODE=drive
SAHABA_DRIVE_WEBAPP_URL=
SAHABA_DRIVE_TOKEN=
# Smaller value suitable for the Apps Script URL Fetch limit (drive mode)
SAHABA_MAX_UPLOAD_MB=20

# One-time migration from an old Drive account to a new one
SAHABA_DRIVE_MIGRATE_FROM_URL=
SAHABA_DRIVE_MIGRATE_FROM_TOKEN=

# SQLite backups (uploaded to Drive in drive mode, or data/backups locally)
SAHABA_BACKUP_ENABLED=1
SAHABA_BACKUP_INTERVAL_HOURS=24
SAHABA_BACKUP_INITIAL_DELAY_MS=15000
SAHABA_BACKUP_RETENTION=7
SAHABA_BACKUP_SPACE=backups

# Per-IP rate limiting (auth is stricter than the rest of the API)
SAHABA_RATE_WINDOW_MS=60000
SAHABA_RATE_MAX=120
SAHABA_AUTH_RATE_WINDOW_MS=600000
SAHABA_AUTH_RATE_MAX=10
